{
  "name": "frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "type-check": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings 0 --cache",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix --cache --cache-location .eslintcache",
